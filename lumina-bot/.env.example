# Bot: copie para .env.dev (desenvolvimento) ou .env (produção).
# O bot acessa MongoDB pela API e não precisa de URI/credenciais de banco.
# Use token de uma aplicação Discord separada em desenvolvimento.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
API_BASE_URL=http://localhost:3000
INTERNAL_API_KEY=
LUMINA_API_KEY=
# Exatamente 32 bytes UTF-8; deve coincidir com a API. Não rotacionar isoladamente.
ENCRYPTION_KEY=

RIOT_API_KEY=
RIOT_BASE_URL=api.riotgames.com
RIOT_MAX_MATCH_HISTORY=10

# O protocolo fica separado do hostname (sem https:// em DASHBOARD_HOST).
DASHBOARD_PROTOCOL=https
DASHBOARD_HOST=bot.luminasink.com

# Comando experimental staff/test ainda referencia estas chaves opcionais.
# Remover junto do comando caso a funcionalidade seja descontinuada.
RULE34_API_KEY=
RULE34_USER_ID=
