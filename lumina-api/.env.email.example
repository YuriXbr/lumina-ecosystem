# Copy these keys into the existing .env.dev (local) / environment variables (Vercel).
# SMTP credentials and the HMAC secret must be filled privately, never in Git or chat.
MAIL_TRANSPORT=gmail_api
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_CODE_SECRET=
ACCOUNT_PUBLIC_ORIGIN=https://bot.luminasink.com
MAIL_FROM_VERIFY=verify@luminasink.com
MAIL_FROM_NOREPLY=noreply@luminasink.com
MAIL_REPLY_TO=suporte@luminasink.com
MAIL_FROM_DEV=devenv@luminasink.com
MAIL_DEV_RECIPIENT=devteam@luminasink.com
