# Docker Compose local: copie para .env na raiz e preencha apenas LUMINA_DEV_*.
# Cada componente tem seu próprio .env.example. Não colocar segredos de produção aqui.
# O Docker não reutiliza MONGODB_URI nem token de produção como fallback.
# Nunca commite .env, .env.dev ou .private.

# Banco dedicado de desenvolvimento, com suporte a transações (replica set).
LUMINA_DEV_MONGODB_URI=
# Gere segredos independentes para desenvolvimento.
LUMINA_DEV_JWT_SECRET=
LUMINA_DEV_INTERNAL_API_KEY=
LUMINA_DEV_API_KEY=
LUMINA_DEV_OAUTH_STATE_SECRET=
# EXATAMENTE 32 bytes UTF-8; igual no bot e API de desenvolvimento.
# Para instalação nova: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
LUMINA_DEV_ENCRYPTION_KEY=

# Aplicação Discord de testes. Bot é opcional: docker compose --profile bot up.
LUMINA_DEV_DISCORD_CLIENT_ID=
LUMINA_DEV_DISCORD_CLIENT_SECRET=
LUMINA_DEV_DISCORD_BOT_TOKEN=
