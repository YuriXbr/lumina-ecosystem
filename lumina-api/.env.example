# API: copie para .env.dev (desenvolvimento) ou .env (produção local).
# Na Vercel, configure diretamente no projeto lumina-api e por ambiente.
# Use banco e credenciais de desenvolvimento separados. Nunca commite valores.
MONGODB_URI=
JWT_SECRET=
OAUTH_STATE_SECRET=
INTERNAL_API_KEY=
LUMINA_API_KEY=

# Compatibilidade do protocolo atual API/bot: EXATAMENTE 32 bytes UTF-8.
# Não trocar uma chave existente: dados já cifrados dependem dela.
# Para instalação NOVA: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
ENCRYPTION_KEY=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_AUTH_REDIRECT_URI=http://localhost:3000/expapi/oauth2/discord/auth/callback

# URL pública incluída nos emails; HTTPS obrigatório em produção.
ACCOUNT_PUBLIC_ORIGIN=http://localhost:5173
# Metadados de atividade do bot (não compõem a URL da API).
DASHBOARD_PROTOCOL=http
DASHBOARD_DOMAIN=localhost:5173

# Servidor local; Vercel fornece PORT/VERCEL/NODE_ENV.
PORT=3000
# IP/hostname anunciado no log de inicialização, não uma origem CORS.
IP=localhost
# Endereços de proxies conhecidos. Não usar true indiscriminadamente.
TRUST_PROXY=loopback
# Origens HTTPS adicionais exatas, separadas por vírgula. Sem curingas.
ADDITIONAL_ALLOWED_ORIGINS=

# Estatísticas Riot; opcional para iniciar a API.
RIOT_API_KEY=
RIOT_BASE_URL=api.riotgames.com
# Log em webhook Discord opcional; contém dados operacionais.
WEBHOOK_URL=

# Gmail API: OAuth de usuário com permissão de envio. Não é chave de serviço.
# Mais detalhes e alternativa SMTP em .env.email.example e docs/.../EMAIL.md.
MAIL_TRANSPORT=gmail_api
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SMTP_USER=
EMAIL_CODE_SECRET=
MAIL_FROM_VERIFY=verify@luminasink.com
MAIL_FROM_NOREPLY=noreply@luminasink.com
MAIL_REPLY_TO=suporte@luminasink.com
MAIL_FROM_DEV=devenv@luminasink.com
MAIL_DEV_RECIPIENT=devteam@luminasink.com

# Coletor OTLP aprovado e opcional, sempre HTTPS. Não usar Web Analytics aqui.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Interpretados pelo SDK OpenTelemetry, não pelo código de negócio:
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
OTEL_SERVICE_NAME=lumina-api
