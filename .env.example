# ═══════════════════════════════════════════════════════════════════════════════
# Lumina Ecosystem — Variáveis de Ambiente
#
# Este arquivo é um TEMPLATE. Copie para `.env` e preencha com seus valores reais:
#
#   cp .env.example .env
#
# Depois edite o .env com suas credenciais. NUNCA commite o .env no git!
#
# O docker-compose.yml lê automaticamente o arquivo .env na raiz do projeto.
#
# IMPORTANTE: Todos os ambientes (Docker local, Vercel, Railway) usam o MESMO
# banco de dados do MongoDB Atlas definido abaixo. Não há MongoDB local.
# ═══════════════════════════════════════════════════════════════════════════════

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
# A connection string do MongoDB Atlas, usada por TODOS os serviços.
# Obtenha em: MongoDB Atlas → Connect → Drivers → Connection String
#
# Formato: mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/ DATABASE
#
# Todos os ambientes usam o mesmo banco. Se quiser separar dev/stage/prod,
# crie databases diferentes no mesmo cluster (ex: lumina, lumina_stage).
MONGODB_URI=

# ── Segurança ──────────────────────────────────────────────────────────────────
# Gere chaves aleatórias fortes com: openssl rand -hex 32

JWT_SECRET=
INTERNAL_API_KEY=
LUMINA_API_KEY=
OAUTH_STATE_SECRET=

# Chave de 32 bytes (64 chars hex) para criptografar dados sensíveis no banco
ENCRYPTION_KEY=

# ── Discord ────────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# URL de callback do OAuth2
DISCORD_AUTH_REDIRECT_URI=http://localhost/expapi/oauth2/discord/auth/callback

# ── URLs ───────────────────────────────────────────────────────────────────────
# Domínio público onde o dashboard está acessível (sem protocolo)
DASHBOARD_DOMAIN=localhost

# ── Riot API (League of Legends) ───────────────────────────────────────────────
RIOT_API_KEY=

# ── Webhook do Discord (opcional) ──────────────────────────────────────────────
WEBHOOK_URL=
