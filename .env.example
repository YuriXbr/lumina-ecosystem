# ═══════════════════════════════════════════════════════════════════════════════
# Lumina Ecosystem — Variáveis de Ambiente
#
# Este arquivo é um TEMPLATE. Copie para `.env` e preencha com seus valores reais:
#
#   cp .env.example .env
#
# Depois edite o .env com suas credenciais. NUNCA commite o .env no git!
#
# O docker-compose.yml lê automaticamente o arquivo .env na raiz do projeto.
#
# Use bancos e credenciais separados para desenvolvimento e produção.
# Docker exige explicitamente LUMINA_DEV_* e não reutiliza MONGODB_URI.
# ═══════════════════════════════════════════════════════════════════════════════

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
# URI do ambiente configurado. O bot acessa dados pela API, sem URI MongoDB.
# Obtenha em: MongoDB Atlas → Connect → Drivers → Connection String
#
# Formato: mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/ DATABASE
#
# Cada ambiente deve ter database e usuário com acesso isolados.
MONGODB_URI=

# ── Segurança ──────────────────────────────────────────────────────────────────
# Gere chaves aleatórias fortes com: openssl rand -hex 32

JWT_SECRET=
INTERNAL_API_KEY=
LUMINA_API_KEY=
OAUTH_STATE_SECRET=

# Chave de 32 bytes (64 chars hex) para criptografar dados sensíveis no banco
ENCRYPTION_KEY=

# ── Discord ────────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# URL de callback do OAuth2
DISCORD_AUTH_REDIRECT_URI=http://localhost/expapi/oauth2/discord/auth/callback

# ── URLs ───────────────────────────────────────────────────────────────────────
# Domínio público onde o dashboard está acessível (sem protocolo)
DASHBOARD_DOMAIN=localhost

# ── Riot API (League of Legends) ───────────────────────────────────────────────
RIOT_API_KEY=

# ── Webhook do Discord (opcional) ──────────────────────────────────────────────
WEBHOOK_URL=

# Docker local (obrigatório; nunca preencher com o banco/tokens de produção)
LUMINA_DEV_MONGODB_URI=
LUMINA_DEV_JWT_SECRET=
LUMINA_DEV_INTERNAL_API_KEY=
LUMINA_DEV_API_KEY=
LUMINA_DEV_OAUTH_STATE_SECRET=
LUMINA_DEV_ENCRYPTION_KEY=
LUMINA_DEV_DISCORD_CLIENT_ID=
LUMINA_DEV_DISCORD_CLIENT_SECRET=
LUMINA_DEV_DISCORD_BOT_TOKEN=

# Origens HTTPS adicionais autorizadas explicitamente (opcional; separadas por vírgula)
ADDITIONAL_ALLOWED_ORIGINS=

# Coletor OTLP compatível aprovado, opcional. Não é o endpoint Web Analytics.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
