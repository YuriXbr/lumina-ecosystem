# Dashboard Vite: TODAS as variáveis VITE_* são públicas e entram no JavaScript.
# Nunca incluir JWT, Gmail, MongoDB, token do bot ou chave interna neste projeto.
# Copie para .env.local. O build de produção usa sua própria configuração Vercel.

# Vazio usa a mesma origem (proxy local ou Nginx); na Vercel use a API HTTPS.
VITE_API_BASE_URL=http://localhost:3000

# ID público da aplicação Discord, usado no convite do bot. Não é um segredo.
VITE_DISCORD_CLIENT_ID=

# Token PÚBLICO do site no Cloudflare Web Analytics; opcional.
# Não é um Cloudflare API token. DNS/proxy não fornecem coleta de traces.
VITE_CF_WEB_ANALYTICS_TOKEN=

# Apenas para revisão local com fixtures; nunca habilitar em produção.
VITE_UI_REVIEW=false
